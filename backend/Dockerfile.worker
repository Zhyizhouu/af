FROM golang:1.24-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.21

# Alpine's ffmpeg package carries libmp3lame, which is the encoder this whole
# service exists to reach. If you swap the base image, check `ffmpeg -encoders
# | grep mp3` still lists it before assuming the build works.
RUN apk add --no-cache ffmpeg ca-certificates \
 && adduser -D -u 10001 af \
 && mkdir -p /work \
 && chown af:af /work

USER af
WORKDIR /work
COPY --from=build /out/worker /usr/local/bin/worker

# Sources are staged here mid-conversion. Compose mounts it as a tmpfs so a
# 500MB upload never lands on the image's writable layer.
ENV AF_TEMP_DIR=/work

ENTRYPOINT ["/usr/local/bin/worker"]
