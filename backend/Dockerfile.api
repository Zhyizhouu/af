# The gateway never runs ffmpeg, so it gets a scratch-adjacent image rather
# than the worker's 300MB of codecs.
FROM golang:1.24-alpine AS build

WORKDIR /src

# Copied first so the module download layer survives every source change.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.21

# Verifying a Firebase ID token means an HTTPS call to Google for the signing
# keys, which needs the trust store the scratch image does not have.
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 af

USER af
COPY --from=build /out/api /usr/local/bin/api

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api"]
