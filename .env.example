# Settings for the MP3 converter stack. Copy to `.env` and edit; every value
# has a default that works on localhost, so an empty file is a valid one.
#
# The Flutter app does not read this — its API URL comes from a --dart-define,
# see the MP3 section of README.md.

# --- object store ---
# Development credentials. They must match docker/seaweedfs/s3.json, which is
# where the S3 gateway reads its side of them from.
AF_S3_ACCESS_KEY=af-local
AF_S3_SECRET_KEY=af-local-secret

# --- auth ---
# The converter verifies the caller's Firebase ID token against this project.
AF_FIREBASE_PROJECT_ID=af-main

# Accepts every request as one shared user, for running the stack before the
# Firebase console work is finished. On anything reachable from outside your
# machine this means strangers can spend your CPU and fill your disk — it is a
# localhost-only convenience.
# AF_AUTH_DISABLED=true

# --- limits ---
# Which origins may call the API. Wildcards allowed, so one entry covers every
# Vercel preview deployment.
AF_ALLOWED_ORIGINS=http://localhost:*,https://*.vercel.app

# 512 MB. Raise with care: the gateway streams uploads rather than buffering
# them, but a worker still stages the whole file on disk to convert it.
AF_MAX_UPLOAD_BYTES=536870912

# How long a finished MP3 stays downloadable. A Temporal timer deletes it when
# this elapses, so the workflow's lifetime and the file's are the same thing.
AF_RESULT_TTL=2h

# Files at once per worker replica. ffmpeg saturates the cores it is handed,
# so more than one here makes every conversion slower — scale replicas instead:
#   docker compose up --scale worker=4
AF_WORKER_MAX_CONCURRENT=1

# --- assistant ---
# The AI program asks Google's Generative Language API. Get a key from
# https://aistudio.google.com/apikey. Without one the page says so on arrival
# rather than offering a button that cannot work.
#
# This key lives here and only here. The Flutter app never sees it — the app is
# a public static bundle, so anything in it is public.
# AF_GEMINI_API_KEY=

# Defaults to the moving alias `gemini-flash-latest`, which never goes stale
# but shares everyone's load — it can return 503 "high demand" for minutes at a
# time. Pinning a specific model avoids that, at the cost of a name that will
# eventually be retired. Note that dated models are withdrawn from new projects
# while continuing to work for ones that already used them, so a pinned name
# that works on one key can 404 on another.
# AF_GEMINI_MODEL=gemini-3.5-flash
