# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Vercel: SDK fetched by vercel-build.sh, plus local CLI state
.flutter/
.vercel/

# Local agent config — machine-specific, not shared
.claude/
CLAUDE.md

# MP3 converter stack: local credentials and limits. .env.example is tracked.
.env

# Firebase service accounts. Verifying a token needs no secret, but writing an
# admin claim does — so `cmd/grant-admin` is the first thing here that wants a
# private key on disk, and a leaked one can mint admins on the live project.
service-account.json
*-service-account.json
serviceAccountKey.json
*.serviceaccount.json
# The name the Firebase console actually generates, which matches none of the
# conventional patterns above: <project>-firebase-adminsdk-<id>.json
*firebase-adminsdk*.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
